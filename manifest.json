{
  "manifest_version": 3,
  "name": "Spot a Dog",
  "version": "0.1.0",
  "description": "Spot the words and phrases that matter with your own keyword profiles.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "sidePanel", "scripting"],
  "host_permissions": ["https://api.openai.com/*", "https://api.anthropic.com/*", "http://*/*", "https://*/*"],
  "background": {"service_worker": "background/worker.js", "type": "module"},
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png"},
  "action": {"default_title": "Spot a Dog", "default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "20": "icons/icon-20.png", "24": "icons/icon-24.png", "32": "icons/icon-32.png", "40": "icons/icon-40.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}},
  "side_panel": {"default_path": "sidepanel/index.html"},
  "commands": {"resume-auto-scroll": {"suggested_key": "Alt+Shift+R", "description": "Resume Auto Scroll"}},
  "options_page": "options/index.html",
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/index.js"], "css": ["content/highlights.css"], "run_at": "document_idle"}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.openai.com https://api.anthropic.com"}
}
